# =================================================================
# Laxmi Enterprises Backend Configuration Template (Hostinger MySQL)
# =================================================================
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------
# Hostinger MySQL Database Credentials
# (Obtained from Hostinger hPanel -> Databases -> MySQL Management)
# -----------------------------------------------------------------
# For Hostinger Web Hosting, DB_HOST is usually 127.0.0.1 (or localhost)
DB_HOST=127.0.0.1
DB_PORT=3306

# Note: In Hostinger, DB_NAME and DB_USER always have an account prefix!
# Example: u829374182_laxmi and u829374182_dbuser
DB_NAME=uXXXXXX_laxmi
DB_USER=uXXXXXX_dbuser
DB_PASSWORD=your_hostinger_database_password
DB_DIALECT=mysql
# Set to false on Hostinger localhost MySQL (SSL is not needed or supported for local socket)
DB_SSL=false

# -----------------------------------------------------------------
# JWT Authentication Secret
# -----------------------------------------------------------------
JWT_SECRET=laxmi_enterprises_production_jwt_secret_key_2026_secured
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------
# CORS Allowed Origins
# -----------------------------------------------------------------
CORS_ORIGIN=https://laxmienterprises.shivcoretech.com,https://darkcyan-buffalo-697008.hostingersite.com,http://localhost:5173

# -----------------------------------------------------------------
# WhatsApp Cloud API (Optional)
# -----------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DAILY_LIMIT=250

# -----------------------------------------------------------------
# Cloudinary Configuration (Optional)
# -----------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
